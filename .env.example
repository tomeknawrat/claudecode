# Copy to `.env` and fill in your Garmin Connect credentials.
# NEVER commit the real .env file — it is git-ignored.

# Required: your Garmin Connect login.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Optional: where OAuth tokens are cached so you only log in once.
# Default: ~/.garminconnect
# GARMIN_TOKEN_STORE=~/.garminconnect

# Optional: one-time 2FA/MFA code, only needed on the FIRST login if your
# account has two-factor authentication enabled. After the first successful
# login the cached tokens are reused and this is no longer required.
# GARMIN_MFA_CODE=123456

# Optional: set to 1 if your account is registered on the Chinese
# garmin.cn domain instead of garmin.com.
# GARMIN_IS_CN=0
